{
  "title": "IronClaw — Pipeline and SLOs",
  "uid": "ironclaw-pipeline",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["ironclaw", "slo"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Ingest SLO — 99.95% monthly",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Ingest failure ratio (5m)",
      "description": "Objective is 0.05%. The measured baseline under a realistic JMeter fleet profile was 0.05% (2 connection resets in 3,765 batches).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.0075 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(ironclaw_http_ingest_rejected_total[5m])) + sum(rate(ironclaw_http_ingest_unauthenticated_total[5m]))) / clamp_min(sum(rate(ironclaw_http_ingest_accepted_total[5m])) + sum(rate(ironclaw_http_ingest_rejected_total[5m])) + sum(rate(ironclaw_http_ingest_unauthenticated_total[5m])), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest request outcomes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_http_ingest_accepted_total[5m]))", "legendFormat": "accepted" },
        { "refId": "B", "expr": "sum(rate(ironclaw_http_ingest_rejected_total[5m]))", "legendFormat": "rejected" },
        { "refId": "C", "expr": "sum(rate(ironclaw_http_ingest_unauthenticated_total[5m]))", "legendFormat": "unauthenticated" }
      ]
    },
    {
      "type": "stat",
      "title": "Events accepted /s",
      "description": "Measured 9,400 events/s from 20 simulated devices. The 1M-device target is 10,000,000/s — see docs/capacity.md.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(rate(ironclaw_ingest_events_accepted_total[5m]))" }]
    },
    {
      "type": "row",
      "title": "Freshness SLO — end-to-end p99 under 5 s",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Estimated drain time (lag ÷ consumption rate)",
      "description": "Time to work off the current backlog. Above 5 s the freshness objective is breached for the newest events. Freshness also has a hard floor at the window size unless -emit-open-windows is set: 10 s windows with closed-window emission measured p99 10.012 s, partial emission measured 1.017 s.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"ironclaw.events.raw.aggregators\"}) / clamp_min(sum(rate(ironclaw_aggregator_batches_consumed_total[5m])), 1)",
          "legendFormat": "aggregators"
        },
        {
          "refId": "B",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"ironclaw.events.aggregated.hot-state\"}) / clamp_min(sum(rate(ironclaw_windows_applied_total[5m])), 1)",
          "legendFormat": "hot-state"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Window flow: emitted → applied → archived",
      "description": "Redis and Postgres are independent consumer groups on the same topic. A persistent gap means one group is stuck, not that events were lost.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_aggregator_windows_emitted_total[5m]))", "legendFormat": "emitted" },
        { "refId": "B", "expr": "sum(rate(ironclaw_windows_applied_total[5m]))", "legendFormat": "applied to redis" },
        { "refId": "C", "expr": "sum(rate(ironclaw_postgres_windows_persisted_total[5m]))", "legendFormat": "archived to postgres" },
        { "refId": "D", "expr": "sum(rate(ironclaw_aggregator_windows_retained_total[5m]))", "legendFormat": "retained (publish failed)" }
      ]
    },
    {
      "type": "row",
      "title": "Correctness — idempotence and poison handling",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Duplicate suppression",
      "description": "At-least-once delivery means redelivery is normal. These counters prove the dedupe path is absorbing it rather than double counting.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_windows_duplicate_total[5m]))", "legendFormat": "redis duplicates" },
        { "refId": "B", "expr": "sum(rate(ironclaw_postgres_windows_duplicate_total[5m]))", "legendFormat": "postgres duplicates" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka retries and dead letters",
      "description": "Dead letters should be flat at zero in steady state.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_kafka_published_total[5m]))", "legendFormat": "published" },
        { "refId": "B", "expr": "sum(rate(ironclaw_kafka_consumed_total[5m]))", "legendFormat": "consumed" },
        { "refId": "C", "expr": "sum(rate(ironclaw_kafka_retried_total[5m]))", "legendFormat": "retried" },
        { "refId": "D", "expr": "sum(rate(ironclaw_kafka_dead_letter_total[5m]))", "legendFormat": "dead-lettered" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage failures",
      "description": "Non-zero means a consumer goroutine died and restarted. This counter exists because those errors used to be discarded silently.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_runtime_stage_failures_total[5m]))", "legendFormat": "stage failures" }
      ]
    },
    {
      "type": "row",
      "title": "Agent fleet — degradation behaviour",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Agent shipping vs spooling",
      "description": "Spooling is the designed response to an edge outage: 61 batches spooled and all drained with zero loss in the verified test. Drops are the only line here that means real loss.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_agent_batches_sent_total[5m]))", "legendFormat": "sent" },
        { "refId": "B", "expr": "sum(rate(ironclaw_agent_batches_spooled_total[5m]))", "legendFormat": "spooled to disk" },
        { "refId": "C", "expr": "sum(rate(ironclaw_agent_batches_drained_total[5m]))", "legendFormat": "drained after recovery" },
        { "refId": "D", "expr": "sum(rate(ironclaw_agent_spool_dropped_total[5m]))", "legendFormat": "dropped (loss)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "MCP read path",
      "description": "Commands are asynchronous by design: a reset is published to Kafka, never written to Redis inline. Dropped watch updates are a slow-subscriber symptom, not data loss.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ironclaw_commands_applied_total[5m]))", "legendFormat": "commands applied" },
        { "refId": "B", "expr": "sum(rate(ironclaw_commands_rejected_total[5m]))", "legendFormat": "commands rejected" },
        { "refId": "C", "expr": "sum(rate(ironclaw_device_resets_total[5m]))", "legendFormat": "device resets" },
        { "refId": "D", "expr": "sum(rate(ironclaw_watch_updates_dropped_total[5m]))", "legendFormat": "watch updates dropped" }
      ]
    }
  ]
}
